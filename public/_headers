/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Game builds keep the same file names between releases, so browsers revalidate them
# (cheap 304s via ETag) instead of caching for a fixed time. Unity also caches the data
# file in IndexedDB, so repeat visits don't re-download it.
/games/*
  Cache-Control: no-cache

